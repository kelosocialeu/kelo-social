# Configuration existante Kelo Social
ADMIN_HANDLES=kelosocial.eu
ADMIN_DIDS=did:plc:...
NEXT_PUBLIC_IDENTITY_VERIFICATION_PDS_URL=https://eurosky.social

# PDS / Gatekeeper Kelo Social
KELO_PDS_URL=https://pds.kelosocial.eu
NEXT_PUBLIC_KELO_PDS_URL=https://pds.kelosocial.eu
# URL publique du service Gatekeeper qui expose GET /gate.
# Si le Gatekeeper est servi sur un autre sous-domaine, remplacez cette valeur.
NEXT_PUBLIC_KELO_GATEKEEPER_URL=https://pds.kelosocial.eu

# Intégration Kelo ID
KELO_ID_URL=https://kelo-id.eu
NEXT_PUBLIC_KELO_ID_URL=https://kelo-id.eu
KELO_SOCIAL_SHARED_SECRET=

# Compte administrateur qui publie les records eu.kelosocial.identityverification
KELO_ADMIN_PDS_URL=https://eurosky.social
KELO_ADMIN_ATPROTO_IDENTIFIER=kelosocial.eu
KELO_ADMIN_ATPROTO_PASSWORD=

# Traduction des publications (service de traduction de contenu utilisateur)
KELO_TRANSLATE_URL=
KELO_TRANSLATE_API_KEY=

# POEditor — traduction de l'interface Kelo Social
# Ces valeurs restent côté serveur/CI et ne doivent jamais être préfixées NEXT_PUBLIC_.
POEDITOR_API_TOKEN=
POEDITOR_PROJECT_ID=
